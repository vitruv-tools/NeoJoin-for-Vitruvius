  <!-- Build -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>gg.jte</groupId>
          <artifactId>jte-maven-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- fail if a dependency is resolved to a lower version than one of the versions requested in the dependency tree -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>enforce-upper-bound-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireUpperBoundDeps />
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Optional style check: ./mvnw validate -P checkstyle
       Runs maven-checkstyle-plugin (version, Checkstyle version and the validate execution come from the parent POM)
       with checkstyle.xml in the repository root. By default, violations are warnings: they are printed and do not
       fail the build. Add -Dcheckstyle.severity=error to make them fail the build. -->
  <profiles>
    <profile>
      <id>checkstyle</id>
      <properties>
        <checkstyle.severity>warning</checkstyle.severity>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-checkstyle-plugin</artifactId>
            <configuration>
              <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
              <propertyExpansion>org.checkstyle.google.severity=${checkstyle.severity}</propertyExpansion>
              <includeTestSourceDirectory>true</includeTestSourceDirectory>
              <excludes>**/src-gen/**,**/generated-sources/**</excludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
